<?xml version="1.0"?>
<robot name="meldog" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- DEPRECATED - kept only so that existing launch files and packages keep working.
         Equivalent to "xacro meldog.urdf.xacro sim:=gazebo".
         Use description/meldog.urdf.xacro with sim:=none|gazebo|mujoco instead.
         The first xacro:arg declaration wins, so this sets the default of meldog.urdf.xacro.
         (This comment is dropped by xacro, because it is directly in front of xacro:arg.) -->
    <xacro:arg name="sim" default="gazebo"/>
    <xacro:include filename="meldog.urdf.xacro"/>

</robot>
