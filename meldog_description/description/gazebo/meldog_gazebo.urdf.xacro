<?xml version="1.0"?>
<!-- Gazebo (Fortress) layer: surface friction, joint springs, IMU and contact sensors, plugins.
     Only parameters that DART actually reads are set, see config/gazebo/gazebo.yaml.
     Requires core/core.urdf.xacro. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- lazy_eval="false": the path is resolved relative to this file -->
    <xacro:property name="meldog_gz" value="${xacro.load_yaml('../../config/gazebo/gazebo.yaml')}" lazy_eval="false"/>

    <xacro:macro name="meldog_gz_link" params="link surface">
        <gazebo reference="${link}">
            <visual>
                <material>
                    <diffuse>${meldog_gz.material_diffuse}</diffuse>
                </material>
            </visual>
            <mu1 value="${surface.mu1}"/>
            <mu2 value="${surface.mu2}"/>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="meldog_gz_joint" params="joint">
        <gazebo reference="${joint}">
            <springStiffness>${meldog_gz.joint_spring.stiffness}</springStiffness>
            <springReference>${meldog_gz.joint_spring.reference}</springReference>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="meldog_gz_imu_noise" params="n">
        <noise type="gaussian">
            <mean>${n.mean}</mean>
            <stddev>${n.stddev}</stddev>
            <bias_mean>${n.bias_mean}</bias_mean>
            <bias_stddev>${n.bias_stddev}</bias_stddev>
        </noise>
    </xacro:macro>

    <!-- Friction, joint springs and the foot contact sensor of one leg.
         collision - collision model (simple | mesh), needed for the contact collision name.
         The foot is attached by a fixed joint, so sdformat lumps it into the lower limb and
         names its collision <LL>_link_fixed_joint_lump__<F>_link_collision_<N>, where N is
         the number of the lower limb's own collisions (they are numbered 0..N-1).
         test/test_description.py checks that this collision exists.
         Keep comments out of macro bodies, see core/part.urdf.xacro. -->
    <xacro:macro name="meldog_gz_leg" params="prefix collision">
        <xacro:property name="s" value="${meldog_gz.surface}"/>
        <xacro:property name="n_ll" value="${len(meldog_geo.links.lower_limb.collision[collision])}"/>
        <xacro:if value="${len(meldog_geo.links.foot.collision[collision]) != 1}">
            ${xacro.fatal('The foot must have exactly one collision shape (contact sensor), collision:=' + collision)}
        </xacro:if>

        <xacro:meldog_gz_link link="${prefix}H_link"  surface="${s.default}"/>
        <xacro:meldog_gz_link link="${prefix}UL_link" surface="${s.default}"/>
        <xacro:meldog_gz_link link="${prefix}LL_link" surface="${s.default}"/>
        <xacro:meldog_gz_link link="${prefix}F_link"  surface="${s.foot}"/>

        <xacro:meldog_gz_joint joint="${prefix}T_joint"/>
        <xacro:meldog_gz_joint joint="${prefix}H_joint"/>
        <xacro:meldog_gz_joint joint="${prefix}K_joint"/>

        <gazebo reference="${prefix}F_link">
            <sensor name="${prefix}F_contact" type="contact">
                <contact>
                    <collision>${prefix}LL_link_fixed_joint_lump__${prefix}F_link_collision_${n_ll}</collision>
                    <topic>${prefix}F_contact</topic>
                </contact>
                <always_on>1</always_on>
                <update_rate>${meldog_gz.contact.update_rate}</update_rate>
            </sensor>
        </gazebo>
    </xacro:macro>

    <!-- Whole Gazebo layer.
         controllers_file - controller_manager parameters loaded by gz_ros2_control
         collision        - collision model used by the core (simple | mesh)
         The IMU sensor name has to match ros2_control and imu_sensor_broadcaster. -->
    <xacro:macro name="meldog_gazebo" params="controllers_file collision">

        <xacro:meldog_gz_link link="trunk_link" surface="${meldog_gz.surface.default}"/>

        <xacro:meldog_gz_leg prefix="LF" collision="${collision}"/>
        <xacro:meldog_gz_leg prefix="RF" collision="${collision}"/>
        <xacro:meldog_gz_leg prefix="LR" collision="${collision}"/>
        <xacro:meldog_gz_leg prefix="RR" collision="${collision}"/>

        <xacro:property name="imu" value="${meldog_gz.imu}"/>
        <gazebo reference="imu_link">
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>${imu.update_rate}</update_rate>
                <visualize>${'true' if imu.visualize else 'false'}</visualize>
                <imu>
                    <angular_velocity>
                        <x><xacro:meldog_gz_imu_noise n="${imu.angular_velocity_noise}"/></x>
                        <y><xacro:meldog_gz_imu_noise n="${imu.angular_velocity_noise}"/></y>
                        <z><xacro:meldog_gz_imu_noise n="${imu.angular_velocity_noise}"/></z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x><xacro:meldog_gz_imu_noise n="${imu.linear_acceleration_noise}"/></x>
                        <y><xacro:meldog_gz_imu_noise n="${imu.linear_acceleration_noise}"/></y>
                        <z><xacro:meldog_gz_imu_noise n="${imu.linear_acceleration_noise}"/></z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>

        <gazebo>
            <plugin filename="libBaseOdometryPublisher.so"
                    name="gazebo_plugins::BaseOdometryPublisher">
                <base_frame_name>trunk_link</base_frame_name>
                <reference_frame_name>world</reference_frame_name>
                <max_publish_frequency>${meldog_gz.odometry.max_publish_frequency}</max_publish_frequency>
            </plugin>
        </gazebo>

        <gazebo>
            <plugin filename="gz_ros2_control-system"
                    name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <robot_param>robot_description</robot_param>
                <robot_param_node>robot_state_publisher</robot_param_node>
                <parameters>${controllers_file}</parameters>
                <hold_joints>true</hold_joints>
            </plugin>
        </gazebo>

    </xacro:macro>

</robot>
